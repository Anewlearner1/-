# Required: Anthropic API key (or run `ant auth login` instead)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Discord Webhook URL for push notifications
# How to get it:
#   1. Open your Discord server → 頻道設定 → 整合 → Webhooks → 建立 Webhook
#   2. 複製 Webhook URL，貼到這裡
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ---------------------------------------------------------------------------
# Taiwan stock agent (main.py)
# ---------------------------------------------------------------------------
# Optional: directory to save reports (default: ./reports)
REPORT_DIR=./reports

# Optional: set to "1" to only run during market hours
#   main.py        → Taiwan  Mon-Fri 09:00-13:30 CST
#   run_us_team.py → US      Mon-Fri 09:30-16:00 ET
MARKET_OPEN_ONLY=0

# ---------------------------------------------------------------------------
# US stock investment team (run_us_team.py)
# ---------------------------------------------------------------------------
# Goal: $30,000 → $1,000,000 in 3 years
GOAL_START_CAPITAL=30000
GOAL_TARGET_CAPITAL=1000000
GOAL_HORIZON_YEARS=3
# GOAL_START_DATE=2026-09-02          # defaults to the day the paper portfolio is created

# Model / effort. Every team member uses the same model.
US_TEAM_MODEL=claude-opus-5
US_TEAM_ANALYST_EFFORT=medium        # low | medium | high | xhigh | max
US_TEAM_PM_EFFORT=high
US_TEAM_WEB_SEARCH=1                 # catalyst analyst may use Anthropic web search (billed per search)
US_TEAM_WEB_SEARCH_MAX_USES=6
US_TEAM_STREAM=1                     # stream bull/bear text to the console

# Paths / data
US_TEAM_STATE_DIR=./state            # paper portfolio JSON lives here
US_TEAM_REPORT_DIR=./reports/us
US_TEAM_HISTORY_PERIOD=1y
US_TEAM_HISTORY_INTERVAL=1d
# US_WATCHLIST=NVDA,AAPL,MSFT,AMZN,GOOGL,META,TSLA,AVGO,AMD,TSM,ARM,PLTR,CRWD,NFLX,LLY,COIN,MSTR,HOOD,APP,SMCI,SOFI,SHOP

# Three-scenario valuation model (optimistic / neutral / conservative)
# Deterministic — computed in code, not by the LLM. Bull/bear growth = base growth
# +/- a spread (percentage points); bull/bear multiple = base multiple x a factor.
VALUATION_HORIZON_YEARS=1
VALUATION_BULL_GROWTH_SPREAD=0.15
VALUATION_BEAR_GROWTH_SPREAD=0.15
VALUATION_GROWTH_FLOOR=-0.30
VALUATION_GROWTH_CAP=1.50
VALUATION_BULL_MULTIPLE_FACTOR=1.30
VALUATION_BEAR_MULTIPLE_FACTOR=0.60
VALUATION_DEFAULT_GROWTH=0.10
VALUATION_PROB_BULL=0.25
VALUATION_PROB_BASE=0.50
VALUATION_PROB_BEAR=0.25

# Hard risk limits (enforced in code, the LLM cannot override them)
RISK_MAX_POSITION_PCT=0.25           # max single position as fraction of equity
RISK_MAX_GROSS_EXPOSURE=1.0          # 1.0 = fully invested, no leverage
RISK_MAX_POSITIONS=6
RISK_MIN_CASH_PCT=0.05
RISK_DEFAULT_STOP_LOSS_PCT=0.12
RISK_MAX_STOP_LOSS_PCT=0.25
RISK_MAX_TRADES_PER_RUN=6
RISK_DRAWDOWN_HALT_PCT=0.25          # no new buys once drawdown from peak reaches this
RISK_MIN_ORDER_USD=200
