# Required: Anthropic API key
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Discord Webhook URL for push notifications
# How to get it:
#   1. Open your Discord server → 頻道設定 → 整合 → Webhooks → 建立 Webhook
#   2. 複製 Webhook URL，貼到這裡
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Optional: directory to save reports (default: ./reports)
REPORT_DIR=./reports

# Optional: set to "1" to only run during Taiwan market hours (Mon-Fri 09:00-13:30 CST)
MARKET_OPEN_ONLY=0
