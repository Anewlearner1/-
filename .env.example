# Required: Anthropic API key (or run `ant auth login` instead)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: Discord Webhook URL for push notifications
# How to get it:
#   1. Open your Discord server → 頻道設定 → 整合 → Webhooks → 建立 Webhook
#   2. 複製 Webhook URL，貼到這裡
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Optional: only run during Taiwan market hours (Mon-Fri 09:00-13:30 CST)
MARKET_OPEN_ONLY=0

# ---- Goal (see tw_team/config.py for all options) ----
# GOAL_START_CAPITAL=1000000
# GOAL_TARGET_CAPITAL=3000000
# GOAL_HORIZON_YEARS=3

# ---- Risk limits (hard-enforced in code, not just prompts) ----
# RISK_MAX_POSITION_PCT=0.25
# RISK_MAX_POSITION_PCT_OTC=0.15
# RISK_MAX_GROSS_EXPOSURE=1.0
# RISK_MAX_POSITIONS=6
# RISK_MIN_CASH_PCT=0.05
# RISK_DEFAULT_STOP_LOSS_PCT=0.12
# RISK_MAX_STOP_LOSS_PCT=0.25
# RISK_MAX_TRADES_PER_RUN=6
# RISK_DRAWDOWN_HALT_PCT=0.25
# RISK_MIN_ORDER_TWD=20000
# RISK_PRICE_LIMIT_PCT=0.10

# ---- Model / runtime ----
# TW_TEAM_MODEL=claude-opus-5
# TW_TEAM_WEB_SEARCH=1
# TW_TEAM_STATE_DIR=./state
